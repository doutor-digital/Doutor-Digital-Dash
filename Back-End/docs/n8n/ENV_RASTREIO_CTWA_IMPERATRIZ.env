# Rastreio de campanha CTWA — Doutor Hérnia Imperatriz
# Variáveis do fluxo 'Meta → Kommo — Rastreio de Campanha CTWA (config por env)'
# Preencher no n8n (Settings → Variables) ou no ambiente do container.

KOMMO_SUBDOMAIN=attivacorpoementeitz
META_GRAPH_VERSION=v23.0
META_APP_SECRET=<app secret do app da Meta>
META_WEBHOOK_VERIFY_TOKEN=<string que você escolher e repetir no Meta>

# --- campos personalizados do lead (Imperatriz) ---
KOMMO_CF_CAMPANHA=2442767
KOMMO_CF_CONJUNTO=2442725
KOMMO_CF_ANUNCIO=2443929
KOMMO_CF_AD_ID=2443931
KOMMO_CF_HEADLINE=2443933
KOMMO_CF_CTWA_CLID=2443935
KOMMO_CF_ORIGEM_URL=2443937
KOMMO_CF_PLATAFORMA=2443939 
KOMMO_CF_ORIGEM_TIPO=2440801
KOMMO_CF_PRIMEIRO_CONTATO=2442697
KOMMO_CF_UTM_SOURCE=888104
KOMMO_CF_UTM_MEDIUM=888100
KOMMO_CF_UTM_CAMPAIGN=888102
KOMMO_CF_UTM_CONTENT=888098
KOMMO_CF_UTM_TERM=888106

# --- comportamento ---
# false = não cria lead; a Kommo cria sozinha ao receber a mensagem.
# Só ligue depois de medir quantos 'órfãos' aparecem no log.
KOMMO_CREATE_IF_MISSING=false
CTWA_LOOKUP_MAX_TENTATIVAS=4
CTWA_LOOKUP_BACKOFF_SEGUNDOS=20
KOMMO_TAG_ORIGEM=Origem: Anuncio pago
ALERT_WEBHOOK_URL=<opcional: webhook de alerta para falha persistente>
